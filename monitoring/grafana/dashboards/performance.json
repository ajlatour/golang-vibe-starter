    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU, by container",
      "description": "CPU used, in cores: 1 is one core fully busy. The API, WireMock and k6 share the machine, so a busy mock or load generator limits what the API is asked to do.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (container) (label_replace(rate(container_cpu_usage_seconds_total{name=~\"golang-vibe-starter-.*\"}[10s]), \"container\", \"$1\", \"name\", \"golang-vibe-starter-([a-z0-9]+?)(-run-[0-9a-f]+)?(-[0-9]+)?\"))",
          "legendFormat": "{{container}}",
          "range": true
        }
      ]
    },
