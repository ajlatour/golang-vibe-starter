# A typical production deployment, behind a load balancer.
ADDR=:8080
UPSTREAM_URL=https://items.internal.example.com/v1
UPSTREAM_TIMEOUT=3s
UPSTREAM_RETRIES=1
REQUEST_TIMEOUT=8s
FLAGS_URL=http://localhost:8016
FLAGS_TIMEOUT=200ms
FLAGS_CACHE_TTL=2s
VALIDATOR_URL=https://validation.internal.example.com
VALIDATOR_TIMEOUT=250ms
VALIDATOR_FAILURE_MODE=closed
API_KEYS_FILE=keys.txt
API_KEYS_RELOAD=30s
API_AUTH_READS=required
MAX_IN_FLIGHT=1024
RATE_LIMIT=200
RATE_BURST=400
HEADER_GUARD_MODE=enforce
LOG_LEVEL=info
LOG_FORMAT=json
LOG_CLIENT_IP=off
RUNTIME_STATS_INTERVAL=1m
PPROF_ADDR=127.0.0.1:6061
SHUTDOWN_TIMEOUT=25s
SHUTDOWN_DELAY=5s
