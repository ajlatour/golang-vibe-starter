{
  "openapi": "3.0.3",
  "info": {
    "title": "golang-vibe-starter API",
    "version": "0.1.0",
    "description": "A small HTTP API over a placeholder `items` resource. Item data comes from an upstream service, so a failure to reach or understand the upstream is reported as 502 or 504, never as a 500. Every response carries a `Client-Correlation-Id` header; send one to tie the service's log lines to your own, or quote the one returned when reporting a problem. Every response also carries `X-Content-Type-Options: nosniff` and `Cache-Control: no-store`. Every route but `/healthz` needs an API key (`Authorization: Bearer <key>`): 401 without a valid one, 403 for a write with a read-only key. Every request's headers are screened first: a request with a body must send `Content-Type: application/json` (415 otherwise), headers have size limits (431), some may appear only once (400), and proxy and method-override headers (`X-Forwarded-*`, `Forwarded`, `X-Real-IP`, `X-HTTP-Method-Override`) are ignored.\n\nThis file is checked against the running handlers by tests (`cmd/api/openapi_test.go`): routes, status codes, response bodies, headers and the limits stated here must match what the service actually does."
  },
  "security": [{ "apiKey": [] }],
  "servers": [
    { "url": "http://localhost:8080", "description": "Local development (docker compose up)" }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "security": [],
        "summary": "Liveness check",
        "description": "Reports ok whenever the process can serve HTTP. It doesn't check the upstream.",
        "parameters": [{ "$ref": "#/components/parameters/CorrelationID" }],
        "responses": {
          "200": {
            "description": "The service is up.",
            "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Health" } }
            }
          },
          "400": { "$ref": "#/components/responses/DuplicateHeader" },
          "431": { "$ref": "#/components/responses/HeadersTooLarge" }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz",
        "security": [],
        "summary": "Readiness check",
        "description": "Whether to send this instance traffic: 200 while it can reach the upstream (any answer from it counts, an error included), 503 once it is shutting down or if it can't reach the upstream at all. Liveness is /healthz. The result is cached for a second, so frequent probes cost little.",
        "parameters": [{ "$ref": "#/components/parameters/CorrelationID" }],
        "responses": {
          "200": {
            "description": "Ready.",
            "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Readiness" } } }
          },
          "503": {
            "description": "Not ready: shutting down, or the upstream can't be reached.",
            "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Readiness" } } }
          },
          "400": { "$ref": "#/components/responses/DuplicateHeader" },
          "431": { "$ref": "#/components/responses/HeadersTooLarge" }
        }
      }
    },
    "/items": {
      "get": {
        "operationId": "listItems",
        "summary": "List items",
        "description": "Returns all items, oldest first. When the `items-list-total` feature flag is on, the response also carries `total`.",
        "parameters": [{ "$ref": "#/components/parameters/CorrelationID" }],
        "responses": {
          "200": {
            "description": "The items.",
            "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ItemList" } }
            }
          },
          "400": { "$ref": "#/components/responses/DuplicateHeader" },
          "431": { "$ref": "#/components/responses/HeadersTooLarge" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "502": { "$ref": "#/components/responses/BadGateway" },
          "504": { "$ref": "#/components/responses/GatewayTimeout" }
        }
      },
      "post": {
        "operationId": "createItem",
        "summary": "Create an item",
        "parameters": [{ "$ref": "#/components/parameters/CorrelationID" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ItemInput" } }
          }
        },
        "responses": {
          "201": {
            "description": "The created item, with its URL in `Location`.",
            "headers": {
              "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" },
              "Location": {
                "required": true,
                "description": "Path of the new item, `/items/{id}`.",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Item" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "431": { "$ref": "#/components/responses/HeadersTooLarge" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "502": { "$ref": "#/components/responses/BadGateway" },
          "504": { "$ref": "#/components/responses/GatewayTimeout" }
        }
      }
    },
    "/items/{id}": {
      "parameters": [
        { "$ref": "#/components/parameters/ItemID" },
        { "$ref": "#/components/parameters/CorrelationID" }
      ],
      "get": {
        "operationId": "getItem",
        "summary": "Get one item",
        "responses": {
          "200": {
            "description": "The item.",
            "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Item" } }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "400": { "$ref": "#/components/responses/DuplicateHeader" },
          "431": { "$ref": "#/components/responses/HeadersTooLarge" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "502": { "$ref": "#/components/responses/BadGateway" },
          "504": { "$ref": "#/components/responses/GatewayTimeout" }
        }
      },
      "put": {
        "operationId": "updateItem",
        "summary": "Replace an item's name and description",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ItemInput" } }
          }
        },
        "responses": {
          "200": {
            "description": "The updated item.",
            "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Item" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "431": { "$ref": "#/components/responses/HeadersTooLarge" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "502": { "$ref": "#/components/responses/BadGateway" },
          "504": { "$ref": "#/components/responses/GatewayTimeout" }
        }
      },
      "delete": {
        "operationId": "deleteItem",
        "summary": "Delete an item",
        "responses": {
          "204": {
            "description": "The item was deleted. No body.",
            "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "400": { "$ref": "#/components/responses/DuplicateHeader" },
          "431": { "$ref": "#/components/responses/HeadersTooLarge" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "502": { "$ref": "#/components/responses/BadGateway" },
          "504": { "$ref": "#/components/responses/GatewayTimeout" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "An API key, sent as `Authorization: Bearer <key>`. A key may read, or read and write; a read-only key's writes get 403. `make api-key` generates one. A deployment can leave reads open (API_AUTH_READS=open), or, for local development only, turn authentication off (API_AUTH=off)."
      }
    },
    "parameters": {
      "ItemID": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The item's ID: 1 to 128 letters, digits, `-` and `_`. No item has any other ID, so any other value is answered with 404.",
        "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$", "maxLength": 128 }
      },
      "CorrelationID": {
        "name": "Client-Correlation-Id",
        "in": "header",
        "required": false,
        "description": "Your own ID for this request. It is echoed in the response and appears as `request_id` on every log line for the request. A value that doesn't fit the schema is ignored, and the service generates one instead.",
        "schema": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }
      }
    },
    "headers": {
      "CorrelationID": {
        "required": true,
        "description": "The request's correlation ID: yours if you sent a valid one, otherwise one the service generated.",
        "schema": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }
      },
      "RetryAfter": {
        "required": true,
        "description": "Seconds to wait before retrying.",
        "schema": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "schemas": {
      "Readiness": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": { "type": "string", "enum": ["ready", "not ready"] },
          "reason": { "type": "string", "description": "Why not: `shutting down`, or `upstream unavailable`." }
        }
      },
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string", "description": "Omitted when empty." },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "ItemInput": {
        "type": "object",
        "additionalProperties": false,
        "description": "The body of a create or replace. The body is limited to 1 MiB, and fields other than these are rejected.",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Required. Surrounding whitespace is trimmed, and what's left must be 1 to 200 characters.",
            "maxLength": 200,
            "pattern": "\\S"
          },
          "description": { "type": "string" }
        }
      },
      "ItemList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } },
          "total": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of items. Present only when the `items-list-total` feature flag is on."
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": { "status": { "type": "string", "enum": ["ok"] } }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": { "type": "string", "description": "A short message safe to show a client. Details are logged, not returned." }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The body isn't usable (malformed JSON, the wrong shape or types, an unknown field, an empty body, or over 1 MiB), or a header that may appear only once (Content-Type, Authorization, Client-Correlation-Id) appears more than once.",
        "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "DuplicateHeader": {
        "description": "A header that may appear only once (Content-Type, Authorization, Client-Correlation-Id) appears more than once.",
        "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "UnsupportedMediaType": {
        "description": "The request has a body, but not Content-Type: application/json (parameters such as charset are fine).",
        "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "No API key, or not a valid one. Send it as `Authorization: Bearer <key>`.",
        "headers": {
          "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" },
          "WWW-Authenticate": { "required": true, "description": "The scheme to use.", "schema": { "type": "string", "pattern": "^Bearer " } }
        },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Forbidden": {
        "description": "The API key may only read.",
        "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "TooManyRequests": {
        "description": "Over the client's rate limit: by default 100 requests a second on average, in bursts of up to 200 (RATE_LIMIT, RATE_BURST). A client is its API key, or its IP address without one. Retry after the given number of seconds.",
        "headers": {
          "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" },
          "Retry-After": { "$ref": "#/components/headers/RetryAfter" }
        },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "ServiceUnavailable": {
        "description": "The service is serving as many requests as it takes at once (MAX_IN_FLIGHT, 512 by default). Retry after the given number of seconds.",
        "headers": {
          "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" },
          "Retry-After": { "$ref": "#/components/headers/RetryAfter" }
        },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "HeadersTooLarge": {
        "description": "The request's headers are over a limit. By default: more than 100 headers, more than 8 KiB for any one header (name and value), or more than 32 KiB in total; a deployment can change these (HEADER_MAX_COUNT, HEADER_MAX_BYTES, HEADER_MAX_TOTAL_BYTES).",
        "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "No item has that ID.",
        "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unprocessable": {
        "description": "The body is well-formed but a value is invalid: `name` is missing, blank, or too long.",
        "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "InternalError": {
        "description": "An unexpected failure in this service itself.",
        "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "BadGateway": {
        "description": "The upstream couldn't give a usable answer: connection refused or reset, an error status, or a body that wouldn't decode.",
        "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "GatewayTimeout": {
        "description": "The upstream didn't answer in time.",
        "headers": { "Client-Correlation-Id": { "$ref": "#/components/headers/CorrelationID" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  }
}
