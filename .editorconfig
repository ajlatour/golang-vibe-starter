# Editor settings that match what the formatters and linters expect.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[{Makefile,*.mk,*.sh,scripts/api}]
indent_style = tab

[*.{json,yaml,yml,feature,js,css,html}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
# Markdown line breaks can be two trailing spaces.
trim_trailing_whitespace = false
